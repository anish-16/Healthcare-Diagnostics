# Copy to .env and adjust values. Never commit the real .env file.

# PostgreSQL connection string (psycopg3 driver).
# Local:     postgresql+psycopg://postgres:postgres@localhost:5432/eve_health
# Docker:    postgresql+psycopg://postgres:postgres@db:5432/eve_health
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eve_health

# Separate database used by the test suite (created by tests/conftest.py if missing).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eve_health_test

# JWT settings — change SECRET_KEY to a long random value in any real deployment.
SECRET_KEY=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# bcrypt cost factor for password hashing (4 is for tests only; keep >= 12 in real use).
BCRYPT_ROUNDS=12
